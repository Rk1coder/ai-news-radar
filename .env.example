# Herhangi bir makineden ayağa kaldırıldığında aynı veriyi görmek için uzak/yönetilen
# bir Postgres kullanılır (yerel Docker volume'üne bağımlı değildir). Örn. Neon,
# Supabase, Railway veya kendi sunucunuzdaki bir Postgres. "+psycopg2" sürücü adını
# ve "sslmode=require" parametresini koruyun; çoğu yönetilen Postgres SSL ister.
# Not: bağlantı havuzu (pooler/PgBouncer) endpoint'i yerine sağlayıcınızın "direct"
# bağlantısını kullanın - bazı yönetilen Postgres sağlayıcılarında pooler endpoint'i
# şema/DDL işlemlerinde tutarsız davranabilir.
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require
ANTHROPIC_API_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Günlük AI özeti e-postası (herhangi bir SMTP sunucusu - Gmail uygulama şifresi,
# Proton Mail Bridge, Resend/Brevo vb.). Gmail için: host=smtp.gmail.com, port=587,
# user=gmail adresiniz, password=myaccount.google.com/apppasswords'tan alınan
# 16 haneli uygulama şifresi (gerçek Gmail şifreniz değil).
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
# starttls (normal SMTP), ssl (implicit TLS), local (loopback/private hydroxide only).
EMAIL_SMTP_SECURITY=starttls
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
# Virgülle ayrılmış alıcı listesi.
EMAIL_RECIPIENTS=
# Bu saatten (yerel) sonraki ilk tarama döngüsünde, günde bir kez gönderilir.
EMAIL_SEND_HOUR=16
# Site's public HTTPS URL; leave blank until deployed.
EMAIL_PUBLIC_URL=

AUTO_SCAN_ENABLED=true
SCAN_TIMEZONE=Europe/Istanbul
SCAN_HOURS=6,10,14,18,22

# Minutes between scans; 0 uses SCAN_HOURS instead.
SCAN_INTERVAL_MINUTES=15
