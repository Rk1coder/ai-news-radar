<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
<meta name="theme-color" content="#ffffff"><title>Radar · Gelişmeleri keşfet</title>
<link rel="icon" href="/radar-favicon.svg" type="image/svg+xml">
<link rel="manifest" href="/manifest.webmanifest">
<script>try{var t=localStorage.getItem("radar-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
<script>if("serviceWorker" in navigator){window.addEventListener("load",function(){navigator.serviceWorker.register("/sw.js")})}</script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600;800&family=Source+Serif+4:opsz,wght@8..60,400&family=Audiowide&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css"><script defer src="/chat-state.js"></script><script defer src="/live-feed.js"></script><script defer src="/app.js"></script><script defer src="/settings.js"></script>
</head>
<body>
<a class="skip-link" href="#news-list">Haberlere geç</a>
<div class="page" id="page-content">
  <header class="topbar">
    <a class="brand wordmark" href="/" aria-label="Radar ana sayfa"><strong>RADAR</strong><span>AI NEWS DETECT &amp; BLOG</span></a>
    <div class="topbar-actions">
      <form action="/refresh" method="post" id="refresh-form"><button class="button subtle refresh" type="submit" aria-label="Haberleri güncelle"><%- icon('arrows-clockwise') %><span>Güncelle</span></button></form>
      <button class="button subtle" type="button" id="open-settings"><%- icon('sliders-horizontal') %><span>Ayarlar</span></button>
    </div>
  </header>
  <div class="status-line"><div id="scan-status" data-running="<%= scanLabels.running %>" data-status="<%= scanLabels.outcome %>" data-count="<%= scanLabels.newCount %>"><span><%= total_count %> kayıt · <%= scanLabels.status %></span><small><%= scanLabels.schedule %></small></div><button class="text-button open-assistant" type="button"><%- icon('sparkle') %> Radar Asistanı</button></div>
  <div id="refresh-message" class="notice" role="status" hidden></div>
  <% if(typeof refreshStarted !== "undefined" && refreshStarted) { %><div class="notice" role="status">Tarama başladı. Yeni haberler hazır olduğunda otomatik görünecek.</div><% } %>
  <% if(refreshBusy) { %><div class="notice" role="status">Tarama zaten devam ediyor. Yeni haberler hazır olduğunda otomatik görünecek.</div><% } %>
  <% if(refreshError) { %><div class="notice error" role="alert">Haberler güncellenemedi. Son kayıtlar gösteriliyor. Güncelle düğmesiyle yeniden deneyebilirsin.</div><% } %>
  <% if(refreshed !== null && !refreshError) { %><div class="notice" role="status"><%= refreshed > 0 ? `${refreshed} yeni gelişme eklendi.` : 'Tarama tamamlandı. Yeni gelişme bulunamadı.' %></div><% } %>
  <div id="digest-region">
  <% if(weekly_digest && weekly_digest.content) { %>
  <details class="briefing">
    <summary><span class="brief-icon"><%- icon('newspaper') %></span><span class="brief-text"><strong>Radar özeti <span class="brief-label">SON 7 GÜNDE TARANAN</span></strong><span class="brief-excerpt"><%= weekly_digest.content %></span></span><%- icon('caret-down') %></summary>
    <div class="brief-full"><p><%= weekly_digest.content %></p><span class="muted"><%= weekly_digest.story_count %> gelişmeden oluşturuldu · <%= digestLabel %> · Yayın tarihleri farklı olabilir.</span></div>
  </details>
  <% } %>
  </div>
  <form method="get" action="/" class="filters-form" id="filters-form">
    <input type="hidden" name="period" value="<%= period %>">
    <nav class="period-tabs" aria-label="Haber dönemi"><% [['all','Son haberler'],['today','Bugün'],['week','Son 7 gün']].forEach(([value,label])=>{ %><a href="<%= qs({period:value}) %>" <%- period===value?'aria-current="page"':'' %>><%= label %></a><% }) %></nav>
    <div class="toolbar">
      <div class="search"><label class="sr-only" for="q-input">Haberlerde ara</label><%- icon('magnifying-glass') %><input id="q-input" type="search" name="q" aria-describedby="search-help" placeholder="Konu veya anahtar kelime ara…" value="<%= q %>"><button type="submit" class="icon-button" aria-label="Ara"><%- icon('arrow-right') %></button></div>
      <button class="button subtle" type="button" id="filter-toggle" aria-expanded="false" aria-controls="filter-fields"><%- icon('sliders-horizontal') %><span>Filtreler</span><% if(sector||source_type||min_priority||show_unverified){ %><span class="filter-dot" aria-label="Etkin filtre var"></span><% } %></button>
      <label class="sort-label"><span class="sr-only">Sıralama</span><select name="sort" id="sort-select"><option value="relevance" <%= sort==='relevance'?'selected':'' %>><%= q ? 'İlgi düzeyine göre' : 'Önerilen' %></option><option value="priority" <%= sort==='priority'?'selected':'' %>>Önceliğe göre</option><option value="recent" <%= sort==='recent'?'selected':'' %>>En yeni</option></select></label>
    </div>
    <p id="search-help" class="muted">Başlık, özet ve konularda ara · Türkçe ve İngilizce konu eşleştirmesi</p>
    <fieldset id="filter-fields" class="filter-fields" hidden><legend class="sr-only">Haber filtreleri</legend>
      <label>Sektör<select name="sector"><option value="">Tüm sektörler</option><% all_sectors.forEach(s=>{ %><option value="<%= s %>" <%= sector===s?'selected':'' %>><%= sectorLabel(s) %></option><% }) %></select></label>
      <label>Kaynak türü<select name="source_type"><option value="">Tüm kaynaklar</option><% Object.entries(source_type_labels).forEach(([key,label])=>{ %><option value="<%= key %>" <%= source_type===key?'selected':'' %>><%= label %></option><% }) %></select></label>
      <label>En düşük öncelik (0–100)<input type="number" name="min_priority" value="<%= min_priority %>" min="0" max="100"></label>
      <label class="checkbox"><input type="checkbox" name="show_unverified" value="true" <%= show_unverified?'checked':'' %>> Teyit bekleyenleri de göster</label>
      <div class="filter-actions"><a href="/" class="text-link">Tümünü temizle</a><button class="button primary" type="submit">Filtreleri uygula</button></div>
    </fieldset>
  </form>
  <% if(q||sector||source_type||min_priority||show_unverified){ %><nav class="active-filters" aria-label="Etkin filtreler">
    <% if(q){ %><a href="<%= qs({q:''}) %>" aria-label="Aramayı temizle"><%= q %> <%- icon('x') %></a><% } %>
    <% if(sector){ %><a href="<%= qs({sector:''}) %>" aria-label="Sektör filtresini kaldır"><%= sectorLabel(sector) %> <%- icon('x') %></a><% } %>
    <% if(source_type){ %><a href="<%= qs({source_type:''}) %>" aria-label="Kaynak filtresini kaldır"><%= source_type_labels[source_type] %> <%- icon('x') %></a><% } %>
    <% if(min_priority){ %><a href="<%= qs({min_priority:0}) %>">Öncelik <%= min_priority %>+ <%- icon('x') %></a><% } %>
    <% if(show_unverified){ %><a href="<%= qs({show_unverified:false}) %>">Teyit bekleyenler dahil <%- icon('x') %></a><% } %>
    <a href="/" class="clear-all">Tümünü temizle</a></nav><% } %>
  <div class="list-heading"><h1 id="feed-heading"><%= period==='today'?'Bugünün haberleri':period==='week'?'Son 7 gün':'Son haberler' %> <span><%= developments.length %></span></h1><label class="original-toggle"><input type="checkbox" id="orig-toggle"> Orijinal başlıklar</label></div>
  <p class="live-update-message" id="live-update-message" role="status"><%= scanLabels.running ? "Tarama sürüyor · 10 saniyede bir kontrol" : "Yeni haberler otomatik eklenir · Dakikada bir kontrol" %></p>
  <main id="news-list" tabindex="-1" aria-label="Haberler">
    <% if(!developments.length){ const archiveCount = typeof searchInfo !== 'undefined' ? searchInfo?.archive_count : null; %>
    <div class="empty-state"><%- icon('magnifying-glass') %>
      <% if(q){ %>
        <h2>Bu filtrelerle eşleşme bulunamadı</h2>
        <% if(archiveCount > 0){ %>
          <p>Seçili tarih aralığında sonuç yok. Aynı arama ve diğer filtrelerle tüm zamanlarda <strong><%= archiveCount %> ilgili haber</strong> bulundu.</p>
          <a href="<%= qs({period:'all'}) %>" class="button primary">Arşivdeki <%= archiveCount %> haberi göster</a>
        <% } else { %>
          <p>Kayıtlı haberlerde aramanla ve etkin filtrelerinle eşleşen bir içerik bulamadık. Daha kısa bir konu deneyebilir veya filtreleri kaldırabilirsin.</p>
          <a href="<%= qs({period:'all',sector:'',source_type:'',min_priority:0}) %>" class="button primary">Aramayı tüm tarihlere ve kaynaklara genişlet</a>
        <% } %>
      <% } else { %>
        <h2><%= period==='today' && !sector && !source_type && !min_priority ? 'Bugün henüz haber yok' : 'Bir eşleşme bulamadık' %></h2>
        <p>Yeni haberler geldiğinde burada otomatik görünecek. Önceki haberleri de inceleyebilirsin.</p>
        <a href="<%= qs({period:'all'}) %>" class="button primary">Tüm tarihlerdeki haberleri göster</a>
      <% } %>
    </div><% } %>
    <% developments.forEach((d,idx)=>{ const source=sourceLabel(d.raw_item.source.name); const title=d.title_tr||d.raw_item.title; const summary=d.summary_tr||d.raw_item.summary||'Bu gelişmenin ayrıntılarını incele veya Radar Asistanı’na sor.'; const url=safeUrl(d.raw_item.url); %>
    <article class="story" data-id="<%= d.id %>" data-dev="<%= JSON.stringify({id:d.id,title,summary,url,source,date:formatDate(d.raw_item.published_at),verified:d.verified}) %>">
      <div class="story-layout"><img class="story-image" alt="" loading="lazy" hidden>
        <div class="story-body">
          <div class="story-meta"><span class="source"><%= source %></span><time><%= formatDate(d.raw_item.published_at) %></time></div>
          <h2><button type="button" class="title-button" data-action="preview"><%= title %></button></h2>
          <% if(d.title_tr && d.title_tr!==d.raw_item.title){ %><p class="original" hidden><%= d.raw_item.title %></p><% } %>
          <p class="story-summary"><%= summary %></p>
          <div class="tags"><% d.sector_tags.slice(0,3).forEach(tag=>{ %><a href="<%= qs({sector:tag}) %>"><%= sectorLabel(tag) %></a><% }) %><% if(d.sector_tags.length>3){ %><span title="<%= d.sector_tags.slice(3).map(sectorLabel).join(', ') %>">+<%= d.sector_tags.length-3 %></span><% } %></div>
          <div class="story-actions"><button type="button" class="button ask-button" data-action="chat" aria-label="<%= title %> hakkında soru sor"><%- icon('chat-circle') %> Soru sor</button><% if(url){ %><a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="source-link">Kaynak <%- icon('arrow-up-right') %></a><% } %></div>
        </div>
        <% if(!d.verified){ %><span class="pending-label">Teyit<br>bekliyor</span><% } %>
      </div>
    </article>
    <% }) %>
  </main>
  <div class="load-more" hidden><p id="visible-count" class="muted"></p><button class="button subtle" id="load-more" type="button">Daha fazla haber <%- icon('caret-down') %></button></div>
  <footer class="page-footer"><a class="wordmark footer-brand" href="/" aria-label="Radar ana sayfa"><strong>RADAR</strong><span>AI NEWS DETECT &amp; BLOG</span></a><span>Kaynağı incele. Bağlamı anla.</span></footer>
</div>
<aside class="assistant" id="assistant" aria-labelledby="assistant-title" hidden>
  <header class="assistant-header"><div class="assistant-name"><%- icon('sparkle') %><h2 id="assistant-title">Radar Asistanı</h2></div><button type="button" class="icon-button" id="close-chat" aria-label="Sohbeti kapat"><%- icon('x') %></button><p>Gündemi birlikte anlamlandıralım.</p></header>
  <div class="chat-context" id="chat-context" hidden><span class="eyebrow">BU HABER HAKKINDA</span><h3 id="chat-title"></h3><div class="context-meta"><span id="chat-source"></span><a id="chat-link" target="_blank" rel="noopener noreferrer">Kaynağı aç <%- icon('arrow-up-right') %></a></div></div>
  <div class="chat-scroll" id="chat-scroll" tabindex="0" aria-label="Sohbet mesajları">
    <div class="chat-welcome" id="chat-welcome"><img src="/radar.svg" width="60" height="60" alt=""><h3>Haberin bir adım ötesine geç.</h3><p>Teknik yenilikleri, arka planı ve pratik etkileri birlikte inceleyelim.</p><span class="welcome-tip" id="welcome-tip">Başlamak için bir haberin “Soru sor” düğmesine dokun.</span></div>
    <div id="chat-messages" role="log" aria-live="polite" aria-relevant="additions text" aria-label="Haber sohbeti"></div>
  </div>
  <div class="chat-bottom">
    <button type="button" class="scroll-bottom-btn" id="scroll-bottom-btn" hidden aria-label="Son mesaja git"><%- icon('caret-down') %></button>
    <div class="suggestions" id="suggestions"><span>Bir soruyla başla</span><div><button type="button" data-question="Bu gelişmeyi kısaca özetler misin?">Kısaca özetle</button><button type="button" data-question="Bu gelişmenin teknik yeniliği ne?">Teknik yenilik ne?</button><button type="button" data-question="Bu gelişme kimler için önemli?">Kimler için önemli?</button></div></div>
    <form id="chat-form"><label class="sr-only" for="chat-input">Haber hakkında sorunuz</label><div class="composer"><textarea id="chat-input" rows="2" maxlength="4000" placeholder="Bu haber hakkında bir soru sor…" disabled></textarea><button class="send-button" id="send-chat" type="submit" aria-label="Soruyu gönder" disabled><%- icon('paper-plane-tilt') %></button></div><p class="composer-help"><%- icon('info') %><span>Yanıtlar seçili haberin bağlamına dayanır.</span></p></form>
  </div>
</aside>
<button class="assistant-launcher button primary open-assistant" id="assistant-launcher" type="button" aria-label="Radar Asistanı’nı aç"><%- icon('sparkle') %><span>Radar Asistanı</span></button>
<dialog id="preview-modal" aria-labelledby="preview-title"><button class="icon-button preview-close" type="button" aria-label="Önizlemeyi kapat"><%- icon('x') %></button><div class="preview-inner"><img id="preview-image" alt="" hidden><span id="preview-meta" class="eyebrow"></span><h2 id="preview-title"></h2><p id="preview-summary"></p><div class="preview-actions"><a id="preview-link" class="button primary" target="_blank" rel="noopener noreferrer">Habere git <%- icon('arrow-up-right') %></a><button type="button" class="button subtle" id="preview-ask"><%- icon('chat-circle') %> Asistana sor</button></div></div></dialog>
<dialog id="settings-modal" aria-labelledby="settings-title">
  <button class="icon-button preview-close" type="button" id="close-settings" aria-label="Ayarları kapat"><%- icon('x') %></button>
  <div class="settings-inner">
    <div class="settings-shell">
      <nav class="settings-nav" aria-label="Ayarlar kategorileri">
        <h2 id="settings-title">Ayarlar</h2>
        <button type="button" class="settings-nav-item is-active" data-panel="scan">Tarama</button>
        <button type="button" class="settings-nav-item" data-panel="sources">Kaynaklar</button>
        <button type="button" class="settings-nav-item" data-panel="custom">Özel kaynak</button>
        <button type="button" class="settings-nav-item" data-panel="appearance">Görünüm</button>
      </nav>
      <div class="settings-main">
        <div class="settings-body" id="settings-body">
          <section class="settings-section" data-panel="scan">
            <h3>Tarama sıklığı</h3>
            <div class="settings-row">
              <div class="settings-row-text">
                <span class="row-label">Tarama aralığı <span class="badge-changed" id="interval-changed" hidden>Değişti</span></span>
                <span class="row-desc">Kaynaklar ne sıklıkla taransın.</span>
              </div>
              <div class="segmented" id="scan-interval-group" role="radiogroup" aria-label="Tarama aralığı">
                <% [['5','5 dk'],['10','10 dk'],['15','15 dk'],['20','20 dk'],['30','30 dk'],['60','60 dk'],['0','Program']].forEach(([value,label])=>{ %>
                <label class="segment"><input type="radio" name="scan-interval" value="<%= value %>" class="sr-only"><span><%= label %></span></label>
                <% }) %>
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-text">
                <span class="row-label">Otomatik tarama <span class="badge-changed" id="auto-scan-changed" hidden>Değişti</span></span>
                <span class="row-desc">Kapatırsan sadece "Güncelle" düğmesiyle tarama yapılır.</span>
              </div>
              <span class="switch"><input type="checkbox" id="auto-scan-enabled"></span>
            </div>
          </section>
          <section class="settings-section" data-panel="sources" hidden>
            <h3>Kaynaklar</h3>
            <input type="search" id="source-filter" class="settings-field" placeholder="Kaynaklarda ara…">
            <div class="source-list" id="source-list"></div>
          </section>
          <section class="settings-section" data-panel="custom" hidden>
            <h3>Özel kaynak ekle</h3>
            <form id="custom-source-form">
              <label class="settings-field">İsim<input type="text" id="custom-name" required></label>
              <label class="settings-field">RSS/Atom URL<input type="url" id="custom-url" placeholder="https://…" required></label>
              <label class="settings-field">Tür
                <select id="custom-type">
                  <option value="company">Şirket</option>
                  <option value="media">Medya</option>
                  <option value="academic">Akademik</option>
                  <option value="defense">Savunma Sanayii</option>
                  <option value="social">Sosyal Medya</option>
                </select>
              </label>
              <button class="button primary" type="submit">Ekle</button>
              <p class="settings-status" id="custom-add-status" role="status"></p>
            </form>
            <div class="source-list" id="custom-source-list"></div>
          </section>
          <section class="settings-section" data-panel="appearance" hidden>
            <h3>Görünüm</h3>
            <div class="settings-row">
              <div class="settings-row-text">
                <span class="row-label">Tema</span>
                <span class="row-desc">Arayüzün açık mı koyu mu görüneceğini seç.</span>
              </div>
              <div class="segmented" id="theme-group" role="radiogroup" aria-label="Tema">
                <% [['system','Sistem'],['light','Açık'],['dark','Koyu']].forEach(([value,label])=>{ %>
                <label class="segment"><input type="radio" name="theme-pref" value="<%= value %>" class="sr-only"><span><%= label %></span></label>
                <% }) %>
              </div>
            </div>
          </section>
        </div>
        <div class="settings-footer" id="settings-footer" hidden>
          <span id="settings-footer-status">Kaydedilmemiş değişiklikler var</span>
          <div class="settings-footer-actions">
            <button type="button" class="button subtle" id="settings-cancel">Vazgeç</button>
            <button type="button" class="button primary" id="settings-save">Kaydet</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>
<noscript><style>.filter-fields[hidden]{display:grid}.assistant-launcher,.open-assistant{display:none}</style><p class="notice">Sohbet ve haber önizlemesi için JavaScript'i etkinleştir. Haber kaynakları ve filtreler kullanılabilir.</p></noscript>
</body></html>
